# Generated SDK surfaces. LF on every checkout so `generate_sdk_surfaces --check`
# compares the same bytes on Windows as on Linux.
*.inc                                   text eol=lf linguist-generated=true
thetadatadx-cpp/include/abi_struct_layout_asserts.hpp.inc -linguist-generated
scripts/ci/data/live_cells.json         text eol=lf linguist-generated=true

# include_str! templates for the code generators. Must stay LF on every
# checkout so Windows builds emit the same bytes as Linux and
# `generate_sdk_surfaces --check` doesn't false-positive.
*.tmpl text eol=lf
*.ipynb linguist-documentation
thetadatadx-ts/index.js                 text eol=lf linguist-generated=true
thetadatadx-ts/index.d.ts               text eol=lf linguist-generated=true

# Codegen drift snapshot. Must stay LF on every checkout so the drift
# check compares the same bytes on Windows as on Linux.
thetadatadx-rs/proto/beta_endpoints.snapshot.rs text eol=lf linguist-generated=true

# The local server's golden responses are compared byte for byte, line endings
# included (the registry CSV ends its lines with CRLF).
tools/server/tests/golden/** -text
