    // Context the C ABI carries through `stream_chunk_shim`: the erased
    // handler plus a slot for the first exception it throws. A C++ exception
    // must never unwind across the C ABI into Rust, so the shim catches it —
    // but rather than DISCARD it (which would lose a chunk while the stream
    // still reported success) it retains the FIRST one and skips every later
    // chunk. The `_stream` method rethrows it once the synchronous drain
    // returns. `fn` outlives every invocation because the C ABI blocks until
    // the stream drains.
    struct StreamHandlerCtx {
        std::function<void(const void*, std::size_t)> fn;
        std::exception_ptr error;
    };

    // Shared trampoline the C ABI invokes once per streamed chunk. It is a
    // static member (so it cannot carry `extern "C"` C language linkage), but
    // its signature matches the C-linkage `ThetaDataDxTickChunkCallback`
    // typedef and every mainstream ABI accepts the assignment. `ctx` is the
    // address of the `StreamHandlerCtx` the calling `_stream` method staged on
    // its stack; the erased handler reinterprets the chunk pointer as the
    // endpoint's tick type and forwards the span to the user handler.
    static void stream_chunk_shim(const void* rows, std::size_t len, void* ctx) noexcept {
        auto* c = static_cast<StreamHandlerCtx*>(ctx);
        if (c == nullptr || c->error) return;
        try {
            c->fn(rows, len);
        } catch (...) {
            c->error = std::current_exception();
        }
    }
