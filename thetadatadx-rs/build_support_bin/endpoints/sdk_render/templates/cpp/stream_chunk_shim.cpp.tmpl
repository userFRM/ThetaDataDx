    // Context the C ABI carries through `stream_chunk_shim`: the erased
    // handler plus a slot for the exception it throws. A C++ exception must
    // never unwind across the C ABI into Rust, so the shim catches it, keeps
    // it, and stops the stream. The `_stream` method rethrows it once the
    // C ABI call returns. `fn` outlives every invocation because the C ABI
    // blocks until the stream ends.
    struct StreamHandlerCtx {
        std::function<void(const void*, std::size_t, const ColumnPresence&)> fn;
        std::exception_ptr error;
    };

    // Shared trampoline the C ABI invokes once per streamed chunk. It is a
    // static member (so it cannot carry `extern "C"` C language linkage), but
    // its signature matches the C-linkage `ThetaDataDxTickChunkCallback`
    // typedef and every mainstream ABI accepts the assignment. `ctx` is the
    // address of the `StreamHandlerCtx` the calling `_stream` method staged on
    // its stack; the erased handler reinterprets the chunk pointer as the
    // endpoint's tick type and forwards the span to the user handler. The
    // library owns `columns` for the duration of the call, so the handler
    // sees it through a `ColumnPresence` that never frees it.
    static int32_t stream_chunk_shim(const void* rows, std::size_t len, const ThetaDataDxColumnPresence* columns, void* ctx) noexcept {
        auto* c = static_cast<StreamHandlerCtx*>(ctx);
        try {
            c->fn(rows, len, ColumnPresence(ColumnPresence::Borrowed{}, *columns));
            return 0;
        } catch (...) {
            c->error = std::current_exception();
            return 1;
        }
    }
